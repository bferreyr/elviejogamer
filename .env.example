# Configuración de Base de Datos PostgreSQL
DB_USER=viejogamer_admin
DB_PASSWORD=tu_contrasena_segura
DB_HOST=localhost
DB_PORT=5432
DB_NAME=viejogamer

# Configuración de Steam Auth
# Obtené tu API Key de: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=tu_steam_api_key

# URL base de tu aplicación (importante para el callback de Steam)
# En producción cambiar a tu dominio (ej: https://elviejogamer.com)
BASE_URL=http://localhost:3003

# Clave secreta para las sesiones (podés poner cualquier texto largo y seguro)
SESSION_SECRET=viejogamer_secreto_super_seguro_2024
